---
import * as c from "../consts"
import { SITE_TITLE } from "../consts"
import ArticleCard from "../components/ArticleCard.astro"
import Main from "../layouts/Main.astro"
import Project from "../components/Project.astro"
import Header from "../components/Header.astro"
import Section from "../layouts/Section.astro"
import CoolWebsites from "../cool-websites/CoolWebsites.astro"

const title = "France"
---

<Main>
  <Section class="prose">
    <a href="/">{SITE_TITLE}</a>
    <>
      <span style="color:var(--color-fg1)">&nbsp;/&nbsp;</span>
      <span>{title}</span>
    </>
    <hr />
    <div>
      <!-- title -->
      <div style="font-weight:600;font-size:24px;margin-bottom:2px">
        {title}
      </div>
    </div>
    <p>Here are some photos of France! (Summer 2026)</p>
    <img
      src="/photos/614dbcf9eaaa4ad17fffee189e126d46ff73416a.png"
      loading="lazy"
    />
    <img
      src="/photos/359f32a45b3441f2fd6393eba4ce066fd162da4b.png"
      loading="lazy"
    />
    <img
      src="/photos/42ac53ca51b4e8b8e284c9ad9d9cf206ba44b6c8.png"
      loading="lazy"
    />
    <img
      src="/photos/cd08941a1346e3f1c7d6f6662a4f9451e6bb8df7.png"
      loading="lazy"
    />
    <img
      src="/photos/596d811785bb23a22b6f93d61bb35d476952c950.png"
      loading="lazy"
    />
    <img
      src="/photos/8dc664092ad1980fba732d9c898f11657ef0677b.png"
      loading="lazy"
    />
    <img
      src="/photos/17e4bc091f2dee60aaf7e1e4134a7e085d403b71.png"
      loading="lazy"
    />
  </Section>
</Main>
<style>
  img {
    max-width: 100%;
  }
</style>
